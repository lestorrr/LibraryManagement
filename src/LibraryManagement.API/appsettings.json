{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=/var/data/library.db"
  },
  "FileStorage": {
    "UploadPath": "/var/data/uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "AllowedHosts": "*"
}
