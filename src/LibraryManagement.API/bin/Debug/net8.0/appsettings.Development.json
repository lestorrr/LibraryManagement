{
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=library.db"
  },
  "FileStorage": {
    "UploadPath": "uploads"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  },
  "Jwt": {
    "Key": "dev-secret-change-this-to-a-secure-key",
    "Issuer": "LibraryManagement",
    "Audience": "LibraryManagement",
    "ExpiryMinutes": 1440
  }
